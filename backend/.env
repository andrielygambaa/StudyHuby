# Copie este arquivo para ".env" (na mesma pasta) e ajuste os dados do seu MySQL.
# O arquivo .env não vai para o GitHub (está no .gitignore).

STUDYHUB_DB_HOST=localhost
STUDYHUB_DB_PORT=3306
STUDYHUB_DB_USER=root
STUDYHUB_DB_PASSWORD=
STUDYHUB_DB_NAME=studyhub

# --- Site publicado (GitHub Pages) e segurança ---
# Endereço(s) do site que podem chamar a API, separados por vírgula (sem barra no final)
# Ex.: STUDYHUB_CORS_ORIGINS=https://seu-usuario.github.io
STUDYHUB_CORS_ORIGINS=
# Endereço completo do site, usado no link do e-mail de recuperação de senha
# Ex.: STUDYHUB_APP_URL=https://seu-usuario.github.io/studyhub
STUDYHUB_APP_URL=
# Servidor de e-mail (SMTP) para a recuperação de senha
STUDYHUB_SMTP_HOST=
STUDYHUB_SMTP_PORT=587
STUDYHUB_SMTP_USER=
STUDYHUB_SMTP_PASSWORD=
STUDYHUB_SMTP_FROM=
# 1 = modo demonstração: sem e-mail, o link de recuperação aparece na tela. Use só no seu computador.
STUDYHUB_DEV_RESET=0
# 1 = a hospedagem fica atrás de um proxy e o IP real vem no cabeçalho X-Forwarded-For
STUDYHUB_TRUST_PROXY=0
